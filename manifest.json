{
    "manifest_version": 3,
    "name": "Youtube Extension",
    "permissions": [
      "activeTab",
      "storage",
      "https://www.youtube.com/*"
    ],
    "description": "Extension for Youtube",
    "version": "1.0",
    "content_scripts": [
      {
        "matches": ["https://www.youtube.com/*"], 
        "js": ["scripts/content-script.js"]
      }
    ],
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": "images/popup-icon.png"
    }
  }